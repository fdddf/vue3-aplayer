{
  "name": "vue3-aplayer",
  "version": "2.0.0",
  "description": "Easy-to-use music player for Vue 3",
  "main": "dist/vue3-aplayer.umd.js",
  "module": "dist/vue3-aplayer.mjs",
  "unpkg": "dist/vue3-aplayer.umd.js",
  "jsdelivr": "dist/vue3-aplayer.umd.js",
  "style": "dist/vue3-aplayer.css",
  "exports": {
    ".": {
      "import": "./dist/vue3-aplayer.mjs",
      "require": "./dist/vue3-aplayer.umd.js"
    },
    "./style.css": "./dist/vue3-aplayer.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fdddf/vue3-aplayer.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "aplayer",
    "vue-aplayer",
    "music-player",
    "audio",
    "html5",
    "component"
  ],
  "author": {
    "name": "Bright",
    "email": "viporg@126.com",
    "url": "https://github.com/fdddf"
  },
  "contributors": [
    "Shenghao \"Doma\" Lei <leishenghao@126.com> (original Vue-APlayer)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/fdddf/vue3-aplayer/issues"
  },
  "homepage": "https://github.com/fdddf/vue3-aplayer#readme",
  "peerDependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "colorthief": "^3.5.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "hls.js": "^1.6.0",
    "sass": "^1.93.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
  },
  "browserslist": [
    "defaults"
  ]
}
